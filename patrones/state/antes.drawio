        <!-- Note of Problems -->
        <mxCell id="a-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=18;fillColor=#ffe6e6;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#990000;fontSize=12;" value="PROBLEMAS (sin patrón State)&lt;br&gt;&lt;br&gt;• &lt;b&gt;Violación de Open/Closed (OCP)&lt;/b&gt;: Agregar un nuevo estado (ej. LowBattery) obliga a modificar Drone y alterar TODOS los métodos (fly, record, land).&lt;br&gt;• &lt;b&gt;Violación de Single Responsibility (SRP)&lt;/b&gt;: Drone acumula el control del dron y las reglas/restricciones de cada estado.&lt;br&gt;• &lt;b&gt;Explosión de condicionales&lt;/b&gt;: Cada acción del dron requiere un switch(this.state) replicado.&lt;br&gt;• &lt;b&gt;Rigidez y difícil testeo&lt;/b&gt;: No se puede probar el comportamiento de un estado aislado sin instanciar la clase monolítica." vertex="1">
          <mxGeometry height="200" width="600" x="320" y="300" as="geometry" />
        </mxCell>

